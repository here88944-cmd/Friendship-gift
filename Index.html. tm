<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>A Special Surprise For You ✨</title>
  
  <!-- Canvas Confetti Library for Mobile Animation -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: #0f0f12;
      color: #f1f1f1;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
      overflow-x: hidden;
    }

    .container {
      background: #18181c;
      border: 1px solid #2a2a32;
      border-radius: 20px;
      padding: 30px 24px;
      width: 100%;
      max-width: 380px;
      text-align: center;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6);
      position: relative;
      z-index: 2;
    }

    h1 {
      font-size: 1.5rem;
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 12px;
    }

    p {
      font-size: 0.95rem;
      color: #a0a0ab;
      line-height: 1.5;
      margin-bottom: 20px;
    }

    /* Name Entry Form */
    .input-group {
      margin-bottom: 15px;
    }

    input[type="text"] {
      width: 100%;
      padding: 14px 16px;
      border-radius: 12px;
      border: 1px solid #33333d;
      background: #101014;
      color: #fff;
      font-size: 1rem;
      outline: none;
      text-align: center;
      transition: border-color 0.3s;
    }

    input[type="text"]:focus {
      border-color: #6c5ce7;
    }

    button {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #6c5ce7, #8e44ad);
      color: white;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(108, 92, 231, 0.3);
      transition: transform 0.1s, opacity 0.2s;
    }

    button:active {
      transform: scale(0.98);
      opacity: 0.9;
    }

    /* Hidden Surprise Section */
    #surpriseCard {
      display: none;
      animation: fadeIn 0.8s ease-in-out forwards;
    }

    .photo-wrapper {
      width: 100%;
      border-radius: 14px;
      overflow: hidden;
      margin-bottom: 18px;
      border: 1px solid #2a2a32;
    }

    .photo-wrapper img {
      width: 100%;
      display: block;
      object-fit: cover;
    }

    .personalized-name {
      color: #a29bfe;
      font-size: 1.6rem;
      margin-bottom: 10px;
    }

    .letter {
      background: #111115;
      padding: 16px;
      border-radius: 12px;
      border-left: 3px solid #6c5ce7;
      text-align: left;
      font-size: 0.9rem;
      color: #d1d1d8;
      line-height: 1.6;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- Screen 1: Input Screen -->
    <div id="inputCard">
      <h1>A Surprise Awaits 🎁</h1>
      <p>Enter your name below to unlock your Friendship Day message.</p>
      
      <div class="input-group">
        <input type="text" id="friendName" placeholder="Type your name..." autocomplete="off">
      </div>
      <button onclick="revealSurprise()">Open Surprise</button>
    </div>

    <!-- Screen 2: Hidden Content -->
    <div id="surpriseCard">
      <div class="photo-wrapper">
        <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=800&q=80" alt="Friends Memory">
      </div>
      
      <h1>Happy Friendship Day!</h1>
      <h2 class="personalized-name" id="displayName"></h2>
      
      <div class="letter">
        <p>Thanks for being such an incredible part of my life. From all the laughter to every shared moment, having a friend like you makes everything better. Wishing you continuous joy and success always! ✨</p>
      </div>
    </div>
  </div>

  <script>
    function triggerConfetti() {
      // Fire confetti bursts from both bottom corners for a full-screen effect
      const count = 200;
      const defaults = {
        origin: { y: 0.7 }
      };

      function fire(particleRatio, opts) {
        confetti(Object.assign({}, defaults, opts, {
          particleCount: Math.floor(count * particleRatio)
        }));
      }

      fire(0.25, {
        spread: 26,
        startVelocity: 55,
      });
      fire(0.2, {
        spread: 60,
      });
      fire(0.35, {
        spread: 100,
        decay: 0.91,
        scalar: 0.8
      });
      fire(0.1, {
        spread: 120,
        startVelocity: 25,
        decay: 0.92,
        scalar: 1.2
      });
      fire(0.1, {
        spread: 120,
        startVelocity: 45,
      });
    }

    function revealSurprise() {
      const nameInput = document.getElementById('friendName').value.trim();
      
      if (nameInput === "") {
        alert("Please enter your name first!");
        return;
      }

      // Format name to capital first letter
      const formattedName = nameInput.charAt(0).toUpperCase() + nameInput.slice(1);
      
      document.getElementById('displayName').innerText = formattedName + " ✨";
      document.getElementById('inputCard').style.display = "none";
      document.getElementById('surpriseCard').style.display = "block";

      // Launch Confetti Animation
      triggerConfetti();
    }
  </script>

</body>
</html>
